{
  "name": "prototype-review",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "docs:build": "python3 scripts/xlsx-to-json.py",
    "dev": "vite",
    "build": "python3 scripts/xlsx-to-json.py && vite build",
    "preview": "vite preview",
    "worker:dev": "cd worker && wrangler dev",
    "worker:deploy": "cd worker && wrangler deploy",
    "worker:db:init": "cd worker && wrangler d1 execute prototype-review-db --file=src/db/schema.sql"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "vite": "^5.4.0"
  }
}
